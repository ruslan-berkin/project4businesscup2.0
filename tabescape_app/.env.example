# Copy this file to .env in tabescape_app. Never commit the real .env or key.
# Eight free campaigns work with these defaults, without any API calls.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
# Turn on only after adding a real server-side key. Premium and Endless then use OpenAI.
# false = unlimited, free demonstration with local stories (no AI generation).
OPENAI_ENABLED=false

# Stable signing secret for story state. Required across server restarts / multiple workers.
# Generate: python -c 'import secrets; print(secrets.token_hex(32))'
TABESCAPE_SECRET_KEY=
PORT=5050
