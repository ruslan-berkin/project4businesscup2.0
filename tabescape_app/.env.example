# Copy to tabescape_app/.env; restart Flask/Gunicorn after changes.
# Keys belong only on the server: never in HTML, JavaScript, GitHub or chat.
# false: local demo. true + a key: real generation in Premium / Endless.
AI_PROVIDER=groq
AI_ENABLED=false
GROQ_API_KEY=
# Optional reserve keys, comma-separated; same-organization keys share limits.
GROQ_API_KEYS=
# This model runs on Groq and needs a Groq key, not an OpenAI key.
GROQ_MODEL=openai/gpt-oss-20b
# Alternative primary providers: AI_PROVIDER=openai or AI_PROVIDER=gemini.
OPENAI_API_KEY=
OPENAI_API_KEYS=
OPENAI_MODEL=gpt-5-mini
GEMINI_API_KEY=
GEMINI_API_KEYS=
GEMINI_MODEL=gemini-3.5-flash-lite
# Optional ONE fallback provider, e.g. gemini. Off by default.
# Enabling it authorizes sending the current story to that service on 401/403/429/5xx.
AI_FALLBACK_PROVIDERS=
# Legacy setting used only if AI_ENABLED is absent:
OPENAI_ENABLED=false
# Generate once: python -c 'import secrets; print(secrets.token_hex(32))'
TABESCAPE_SECRET_KEY=
PORT=5050

# Optional dedicated PostgreSQL URL for research events. Takes precedence over SQLite.
# ANALYTICS_DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=verify-full&sslrootcert=system
# Local SQLite fallback when no URL is configured (ephemeral on Render Free).
# ANALYTICS_DB_PATH=.data/research.sqlite3
