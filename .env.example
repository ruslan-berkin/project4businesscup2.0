# Copy this file to tabescape_app/.env, then restart the Flask/Gunicorn server.
# Do not put the API key in JavaScript, HTML, GitHub or a message.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
# false: no-key demo. true: real API calls for Premium and Endless only.
OPENAI_ENABLED=false
# Generate once: python -c 'import secrets; print(secrets.token_hex(32))'
TABESCAPE_SECRET_KEY=
PORT=5050
