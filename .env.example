# Copy to tabescape_app/.env; restart Flask/Gunicorn after changes.
# Keys belong only on the server: never in HTML, JavaScript, GitHub or chat.
# false: local demo. true + a key: real generation in Premium / Endless.
AI_PROVIDER=groq
AI_ENABLED=false
GROQ_API_KEY=
# This model runs on Groq and needs a Groq key, not an OpenAI key.
GROQ_MODEL=openai/gpt-oss-20b
# Alternative: AI_PROVIDER=openai (no automatic fallback between providers).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
# Legacy setting used only if AI_ENABLED is absent:
OPENAI_ENABLED=false
# Generate once: python -c 'import secrets; print(secrets.token_hex(32))'
TABESCAPE_SECRET_KEY=
PORT=5050
